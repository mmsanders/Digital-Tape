{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digital Tape",
  "version": "0.1.0",
  "identifier": "org.digitaltape.app",
  "build": { "frontendDist": "frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Digital Tape", "width": 600, "height": 650, "resizable": true, "dragDropEnabled": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
