<?xml version="1.0" encoding="utf-8"?>
<!-- #451: in-box kernel trace with object HANDLE events (create/close carry the
     object name) alongside FileIO, to test whether a device-open attempt is visible. -->
<WindowsPerformanceRecorder Version="1.0" Author="Digital Tape Software" Comments="device-open visibility probe">
  <Profiles>
    <SystemCollector Id="DevOpenCollector" Name="NT Kernel Logger">
      <BufferSize Value="1024"/>
      <Buffers Value="128"/>
    </SystemCollector>
    <SystemProvider Id="DevOpenProvider">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="Handle"/>
        <Keyword Value="FileIO"/>
        <Keyword Value="FileIOInit"/>
      </Keywords>
    </SystemProvider>
    <Profile Id="DevOpen.Verbose.File" Name="DevOpen" Description="Handle + FileIO" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="DevOpenCollector">
          <SystemProviderId Value="DevOpenProvider"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
